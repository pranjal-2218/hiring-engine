FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit==1.28.2 httpx==0.25.2 plotly==5.18.0 pandas==2.1.3

COPY frontend/ ./frontend/

EXPOSE 8501
HEALTHCHECK --interval=30s CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
