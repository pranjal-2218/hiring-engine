# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Intelligent Hiring Engine"
APP_VERSION="1.0.0"
ENV=development
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
API_KEY=your-api-key-for-external-access

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hiring_engine
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=hiring_engine
REDIS_URL=redis://localhost:6379/0

# ── LLM (choose one provider) ─────────────────────────────────────────────────
LLM_PROVIDER=anthropic           # or "openai"
ANTHROPIC_API_KEY=               # your Anthropic API key
OPENAI_API_KEY=                  # your OpenAI API key (optional)
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── ML ────────────────────────────────────────────────────────────────────────
MODEL_DIR=ml/artifacts
RANKER_MODEL_PATH=ml/artifacts/xgb_ranker.json
SCALER_PATH=ml/artifacts/feature_scaler.pkl

# ── Ranking Weights (must sum to 1.0) ─────────────────────────────────────────
WEIGHT_SEMANTIC=0.40
WEIGHT_ML_SCORE=0.35
WEIGHT_SKILL_MATCH=0.15
WEIGHT_EXPERIENCE=0.10

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=data/raw/uploads

# ── Anti-Fraud ───────────────────────────────────────────────────────────────
LSH_THRESHOLD=0.85
LSH_NUM_PERM=128
STUFFING_ZSCORE_THRESHOLD=2.5

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]
